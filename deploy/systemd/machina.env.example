# Machina systemd environment — copy to /etc/machina/machina.env
# Permissions: chmod 600 /etc/machina/machina.env
# Owner: root:machina (or root:root — systemd reads it before dropping privileges)
# NEVER commit secrets to version control
#
# Only variables that your /etc/machina/config.yaml references with ${VAR}
# (plus the MCP token variables below) have any effect. The MCP server makes
# no LLM calls, so it needs no LLM key.

# --- MCP Authentication (required) ---
# JSON object mapping tokens to client identifiers. Every token must be at
# least 32 characters: generate each with `openssl rand -hex 32`.
MACHINA_MCP_TOKENS_JSON=

# --- CMMS Connection (referenced by config.yaml) ---
MACHINA_CMMS_URL=https://your-cmms-host.example.com/api
MACHINA_CMMS_API_KEY=

# --- Behaviour (referenced by config.yaml) ---
# true: writes are logged and answered with a [SANDBOX] result, nothing
# reaches the CMMS. Start with true and switch to false once verified.
MACHINA_SANDBOX_MODE=true
MACHINA_LOG_LEVEL=INFO
