# Machina MCP server (Docker) — copy to .env and fill in values.
# NEVER commit .env to version control.
#
# The MCP server makes no LLM calls: no LLM key is needed here.

# --- MCP Authentication (required) ---
# JSON object mapping tokens to client identifiers. Every token must be at
# least 32 characters — the server refuses to start otherwise, so this
# placeholder does not work as is. Generate each with: openssl rand -hex 32
MACHINA_MCP_TOKENS_JSON={"change-me": "your-client-id"}

# --- CMMS Connection ---
# Unset, docker-compose.yml points at the bundled mock CMMS (any token works).
# For a real CMMS, set both:
# MACHINA_CMMS_URL=https://your-cmms.example.com/api
# MACHINA_CMMS_API_KEY=

# --- Sandbox Mode ---
# true (default): writes are logged and answered with a [SANDBOX] result.
MACHINA_SANDBOX_MODE=true

# --- Logging ---
MACHINA_LOG_LEVEL=INFO
