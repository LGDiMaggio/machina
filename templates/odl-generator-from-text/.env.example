# odl-generator-from-text — copy to .env and fill in what you use.
# NEVER commit .env to version control.

# --- LLM (required: the agent reads the request with it) ---
# Any LiteLLM model id, e.g. openai/gpt-4o, or ollama/qwen3:8b for a local
# model (Ollama running, no key needed).
MACHINA_LLM_MODEL=openai/gpt-4o
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Mode ---
# true (default): work orders are proposed and logged, never written.
# --sandbox / --live on the command line take precedence.
MACHINA_SANDBOX_MODE=true

# --- Logging ---
MACHINA_LOG_LEVEL=INFO

# --- REST CMMS substrate (only with --config config.cmms-rest.yaml) ---
# MACHINA_CMMS_URL=http://localhost:9000
# MACHINA_CMMS_API_KEY=

# --- Telegram channel (only if enabled in config.yaml) ---
# MACHINA_TELEGRAM_BOT_TOKEN=
